# XH Panel 环境变量示例
# 复制为 .env 并填入真实值，或在 systemd 中注入（参见 deploy/app-panel.service）

# --- 必填 ---
# JWT 签名密钥（生产必须改成随机长字符串）
APP_PANEL_SECRET=please-change-me

# MinIO（部署文档存储，如未配置则文档功能不可用）
APP_PANEL_MINIO_ENDPOINT=127.0.0.1:9000
APP_PANEL_MINIO_ACCESS=your-minio-access-key
APP_PANEL_MINIO_SECRET=your-minio-secret-key
APP_PANEL_MINIO_BUCKET=document
APP_PANEL_MINIO_PUBLIC=http://127.0.0.1:9001

# --- 可选 ---
# 数据目录（默认 backend/data）
# APP_PANEL_DATA=/opt/app-panel/data
# 面板端口（默认 8085）
# APP_PANEL_PORT=8085
# 首次初始化管理员账号密码（默认 admin / admin123）
# APP_PANEL_ADMIN_USER=admin
# APP_PANEL_ADMIN_PASSWORD=admin123
# systemctl 调用方式（默认 /usr/bin/sudo）
# APP_PANEL_SUDO=/usr/bin/sudo
