[Unit]
Description=App Management Panel (FastAPI)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/app-panel/backend
Environment=APP_PANEL_DATA=/opt/app-panel/data
Environment=APP_PANEL_PORT=1234
ExecStart=/opt/app-panel-venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 1234
Restart=always
RestartSec=5
StandardOutput=append:/opt/app-panel/backend/app.log
StandardError=append:/opt/app-panel/backend/app.log

[Install]
WantedBy=multi-user.target
